{
  "name": "alexgaffen-site",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Personal site: React + TypeScript + Tailwind, prerendered to static HTML.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && node scripts/build.ts",
    "preview": "vite preview --outDir dist",
    "typecheck": "tsc --noEmit",
    "icons": "python3 scripts/subset-icons.py"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@fortawesome/fontawesome-free": "^6.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "devicon": "^2.16.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^8.3.4"
  },
  "engines": {
    "node": ">=22.18"
  }
}
